<Window x:Class="ExecutePrograms.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ExecutePrograms.Models"
        Title="ExecutePrograms" Height="860" Width="740"
        MinHeight="640" MinWidth="620"
        Background="#F0F2F5">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#D0D7DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#24292F"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="BorderBrush" Value="#D0D7DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="BorderBrush" Value="#D0D7DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="BrowseBtn" TargetType="Button">
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Content" Value="찾기"/>
            <Setter Property="Background" Value="#F6F8FA"/>
            <Setter Property="Foreground" Value="#24292F"/>
            <Setter Property="BorderBrush" Value="#D0D7DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E6EBF0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="#57606A"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <!-- 고정 명령어 표시 박스 -->
        <Style x:Key="CmdBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="#D0D7DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#F6F8FA"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CmdText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#656D76"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 프로그램 섹션 내부 구분 박스 -->
        <Style x:Key="PrgBlock" TargetType="Border">
            <Setter Property="BorderBrush" Value="#E8EBEF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="#FAFBFC"/>
        </Style>

        <Style x:Key="PrgLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#24292F"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="ExeFixedLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#57606A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 0: 프로필 바 -->
            <RowDefinition Height="Auto"/>   <!-- 1: 실행 버튼 -->
            <RowDefinition Height="Auto"/>   <!-- 2: 실행 흐름 바 -->
            <RowDefinition Height="*"/>      <!-- 3: 설정 영역 -->
            <RowDefinition Height="220"/>    <!-- 4: 로그 영역 -->
        </Grid.RowDefinitions>

        <!-- ── 프로필 바 ── -->
        <Border Grid.Row="0" Background="White" BorderBrush="#D0D7DE" BorderThickness="1"
                CornerRadius="6" Margin="0,0,0,8" Padding="14,10">
            <DockPanel>
                <TextBlock Text="프로필" VerticalAlignment="Center"
                           FontSize="12" FontWeight="SemiBold" Foreground="#57606A"
                           Margin="0,0,12,0"/>
                <Rectangle DockPanel.Dock="Left" Width="1" Fill="#D0D7DE" Margin="0,0,12,0"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="ProfileComboBox"
                              IsEditable="True"
                              Width="200" Height="30"
                              VerticalContentAlignment="Center"
                              Padding="6,0" FontSize="12"
                              ToolTip="프로필 이름을 선택하거나 새 이름을 입력하세요"
                              SelectionChanged="ProfileComboBox_SelectionChanged"/>
                    <Button Content="저장" Width="52" Height="30" Margin="6,0,0,0"
                            FontSize="12" ToolTip="현재 설정을 이 이름으로 저장"
                            Click="SaveProfile_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#2DA44E"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#238840"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="삭제" Width="52" Height="30" Margin="4,0,0,0"
                            FontSize="12" ToolTip="선택한 프로필 삭제"
                            Click="DeleteProfile_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#F6F8FA"/>
                                <Setter Property="Foreground" Value="#CF222E"/>
                                <Setter Property="BorderBrush" Value="#D0D7DE"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FFEBE9"/>
                                        <Setter Property="BorderBrush" Value="#CF222E"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── 실행 버튼 ── -->
        <Button x:Name="ExecuteBtn" Grid.Row="1"
                Content="▶  실행"
                Height="44" Margin="0,0,0,8"
                FontSize="15" FontWeight="Bold"
                Click="ExecuteBtn_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="#1F6FEB"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#1A5FCC"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="#8BB4F0"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <!-- ── 실행 흐름 바 ── -->
        <Border Grid.Row="2" Background="White" BorderBrush="#D0D7DE" BorderThickness="1"
                CornerRadius="6" Margin="0,0,0,8" Padding="14,9">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                <Border x:Name="Step1Border" Background="#F6F8FA" BorderBrush="#D0D7DE"
                        BorderThickness="1" CornerRadius="4" Padding="12,4">
                    <TextBlock x:Name="Step1Text" Text="① 종료" Foreground="#8B949E"
                               FontSize="12" FontWeight="SemiBold"/>
                </Border>
                <TextBlock Text="  ──▶  " VerticalAlignment="Center" Foreground="#C0C8D0" FontSize="13"/>

                <Border x:Name="Step2Border" Background="#F6F8FA" BorderBrush="#D0D7DE"
                        BorderThickness="1" CornerRadius="4" Padding="12,4">
                    <TextBlock x:Name="Step2Text" Text="② xms DB" Foreground="#8B949E"
                               FontSize="12" FontWeight="SemiBold"/>
                </Border>
                <TextBlock Text="  ──▶  " VerticalAlignment="Center" Foreground="#C0C8D0" FontSize="13"/>

                <Border x:Name="Step3Border" Background="#F6F8FA" BorderBrush="#D0D7DE"
                        BorderThickness="1" CornerRadius="4" Padding="12,4">
                    <TextBlock x:Name="Step3Text" Text="③ xflow DB" Foreground="#8B949E"
                               FontSize="12" FontWeight="SemiBold"/>
                </Border>
                <TextBlock Text="  ──▶  " VerticalAlignment="Center" Foreground="#C0C8D0" FontSize="13"/>

                <Border x:Name="Step4Border" Background="#F6F8FA" BorderBrush="#D0D7DE"
                        BorderThickness="1" CornerRadius="4" Padding="12,4">
                    <TextBlock x:Name="Step4Text" Text="④ SQL" Foreground="#8B949E"
                               FontSize="12" FontWeight="SemiBold"/>
                </Border>
                <TextBlock Text="  ──▶  " VerticalAlignment="Center" Foreground="#C0C8D0" FontSize="13"/>

                <Border x:Name="Step5Border" Background="#F6F8FA" BorderBrush="#D0D7DE"
                        BorderThickness="1" CornerRadius="4" Padding="12,4">
                    <TextBlock x:Name="Step5Text" Text="⑤ 시작" Foreground="#8B949E"
                               FontSize="12" FontWeight="SemiBold"/>
                </Border>

            </StackPanel>
        </Border>

        <!-- ── 설정 영역 ── -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
            <StackPanel>

                <!-- 실행 설정 -->
                <GroupBox>
                    <GroupBox.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#D73A3A" CornerRadius="3" Padding="5,1" Margin="0,0,4,0">
                                <TextBlock Text="①" FontSize="11" FontWeight="Bold" Foreground="White"/>
                            </Border>
                            <Border Background="#2DA44E" CornerRadius="3" Padding="5,1" Margin="0,0,8,0">
                                <TextBlock Text="⑤" FontSize="11" FontWeight="Bold" Foreground="White"/>
                            </Border>
                            <TextBlock Text="실행 설정" FontWeight="SemiBold" Foreground="#24292F" VerticalAlignment="Center"/>
                        </StackPanel>
                    </GroupBox.Header>
                    <StackPanel>

                        <!-- ── xms 서비스 ── -->
                        <Border Style="{StaticResource PrgBlock}">
                            <StackPanel>
                                <TextBlock Text="● xms  (서비스)" Style="{StaticResource PrgLabel}"/>

                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="실행 위치" Style="{StaticResource FieldLabel}" Width="72"/>
                                    <Button Style="{StaticResource BrowseBtn}" DockPanel.Dock="Right"
                                            Click="BrowseBatDir_Click"/>
                                    <TextBox x:Name="BatDir"
                                             Text="C:\Project\Release\xms"
                                             ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                </DockPanel>

                                <DockPanel Margin="0,0,0,4">
                                    <CheckBox x:Name="BatStartCheck" IsChecked="True" DockPanel.Dock="Left"
                                              VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="시작" Style="{StaticResource FieldLabel}"
                                               Width="36" DockPanel.Dock="Left"/>
                                    <Border Style="{StaticResource CmdBorder}">
                                        <TextBlock Style="{StaticResource CmdText}" Text=".\xms.exe service start"/>
                                    </Border>
                                </DockPanel>

                                <DockPanel>
                                    <CheckBox x:Name="BatStopCheck" IsChecked="True" DockPanel.Dock="Left"
                                              VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="종료" Style="{StaticResource FieldLabel}"
                                               Width="36" DockPanel.Dock="Left"/>
                                    <Border Style="{StaticResource CmdBorder}">
                                        <TextBlock Style="{StaticResource CmdText}" Text=".\xms.exe service stop"/>
                                    </Border>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- ── xflowd EXE ── -->
                        <Border Style="{StaticResource PrgBlock}">
                            <StackPanel>
                                <TextBlock Text="● xflowd  (EXE)" Style="{StaticResource PrgLabel}"/>

                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="실행 위치" Style="{StaticResource FieldLabel}" Width="72"/>
                                    <Button Style="{StaticResource BrowseBtn}" DockPanel.Dock="Right"
                                            Click="BrowseExeDir_Click"/>
                                    <TextBox x:Name="ExeDir"
                                             Text="C:\Project\xflow\Src\xflowd\bin\Debug\net10.0"
                                             ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                </DockPanel>

                                <DockPanel Margin="0,0,0,4">
                                    <CheckBox x:Name="ExeStartCheck" IsChecked="True" DockPanel.Dock="Left"
                                              VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="시작" Style="{StaticResource FieldLabel}"
                                               Width="36" DockPanel.Dock="Left"/>
                                    <Border Style="{StaticResource CmdBorder}">
                                        <TextBlock Style="{StaticResource CmdText}" Text=".\xflowd.exe"/>
                                    </Border>
                                </DockPanel>

                                <DockPanel>
                                    <CheckBox x:Name="ExeStopCheck" IsChecked="True" DockPanel.Dock="Left"
                                              VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="종료" Style="{StaticResource FieldLabel}"
                                               Width="36" DockPanel.Dock="Left"/>
                                    <Border Style="{StaticResource CmdBorder}">
                                        <TextBlock Style="{StaticResource CmdText}"
                                                   Text="xflowd.exe 프로세스 종료"/>
                                    </Border>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- ── FEX ── -->
                        <Border Style="{StaticResource PrgBlock}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="● FEX  (GUI)" Style="{StaticResource PrgLabel}"/>

                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="워크스페이스" Style="{StaticResource FieldLabel}" Width="72"/>
                                    <TextBox x:Name="FexWorkspace"
                                             ToolTip="비워두면 Default 워크스페이스로 실행"/>
                                </DockPanel>

                                <DockPanel Margin="0,0,0,4">
                                    <CheckBox x:Name="FexStartCheck" IsChecked="True" DockPanel.Dock="Left"
                                              VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="시작" Style="{StaticResource FieldLabel}"
                                               Width="36" DockPanel.Dock="Left"/>
                                    <Border Style="{StaticResource CmdBorder}">
                                        <TextBlock Style="{StaticResource CmdText}" Text="Fex Hub.exe"/>
                                    </Border>
                                </DockPanel>

                                <DockPanel>
                                    <CheckBox x:Name="FexStopCheck" IsChecked="True" DockPanel.Dock="Left"
                                              VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="종료" Style="{StaticResource FieldLabel}"
                                               Width="36" DockPanel.Dock="Left"/>
                                    <Border Style="{StaticResource CmdBorder}">
                                        <TextBlock Style="{StaticResource CmdText}"
                                                   Text="Fex.exe 프로세스 종료"/>
                                    </Border>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- ── 추가 프로그램 목록 ── -->
                        <ItemsControl x:Name="ExtraProgramsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ExtraProgram}">
                                    <Border Background="#FAFBFC" BorderBrush="#D0D7DE" BorderThickness="1"
                                            CornerRadius="4" Padding="12,10" Margin="0,0,0,8">
                                        <StackPanel>

                                            <!-- 이름 + 창표시 + 제거 -->
                                            <DockPanel Margin="0,0,0,8">
                                                <Button DockPanel.Dock="Right"
                                                        Content="✕" Width="28" Height="28"
                                                        ToolTip="제거" Cursor="Hand"
                                                        Click="RemoveExtraProgram_Click">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="Foreground" Value="#8B949E"/>
                                                            <Setter Property="BorderThickness" Value="0"/>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Foreground" Value="#CF222E"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <CheckBox DockPanel.Dock="Right" Content="창 표시"
                                                          IsChecked="{Binding ShowWindow}"
                                                          VerticalAlignment="Center" Margin="0,0,8,0"
                                                          FontSize="12" Foreground="#57606A"/>
                                                <TextBlock Text="이름" Width="72" VerticalAlignment="Center"
                                                           FontSize="12" Foreground="#57606A" FontWeight="SemiBold"/>
                                                <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                                         FontSize="12"/>
                                            </DockPanel>

                                            <!-- 실행 파일 경로 -->
                                            <DockPanel Margin="0,0,0,8">
                                                <TextBlock Text="실행 파일" Width="72" VerticalAlignment="Center"
                                                           FontSize="12" Foreground="#57606A" FontWeight="SemiBold"/>
                                                <Button DockPanel.Dock="Right"
                                                        Content="찾기" Width="60" Height="30" Margin="6,0,0,0"
                                                        Cursor="Hand" Click="BrowseExtraExe_Click"
                                                        Style="{StaticResource BrowseBtn}"/>
                                                <TextBox Text="{Binding ExePath, UpdateSourceTrigger=PropertyChanged}"
                                                         FontSize="12"
                                                         ToolTip="{Binding ExePath}"/>
                                            </DockPanel>

                                            <!-- 시작 -->
                                            <DockPanel Margin="0,0,0,4">
                                                <CheckBox IsChecked="{Binding StartEnabled}"
                                                          DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBlock Text="시작" Width="36" DockPanel.Dock="Left"
                                                           FontSize="12" Foreground="#57606A" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                                <Border Background="#F6F8FA" BorderBrush="#D0D7DE"
                                                        BorderThickness="1" CornerRadius="3" Padding="8,4">
                                                    <TextBlock FontFamily="Consolas" FontSize="12" Foreground="#57606A">
                                                        <Run Text=".\"/><Run Text="{Binding FileName, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </Border>
                                            </DockPanel>

                                            <!-- 종료 -->
                                            <DockPanel>
                                                <CheckBox IsChecked="{Binding StopEnabled}"
                                                          DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBlock Text="종료" Width="36" DockPanel.Dock="Left"
                                                           FontSize="12" Foreground="#57606A" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                                <Border Background="#F6F8FA" BorderBrush="#D0D7DE"
                                                        BorderThickness="1" CornerRadius="3" Padding="8,4">
                                                    <TextBlock FontFamily="Consolas" FontSize="12" Foreground="#57606A">
                                                        <Run Text="{Binding FileName, Mode=OneWay}"/><Run Text=" 프로세스 종료"/>
                                                    </TextBlock>
                                                </Border>
                                            </DockPanel>

                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- + 프로그램 추가 버튼 -->
                        <Button Click="AddExtraProgram_Click"
                                HorizontalAlignment="Left" Height="30" Padding="12,0"
                                FontSize="12" Cursor="Hand" Margin="0,0,0,4">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#1F6FEB"/>
                                    <Setter Property="BorderBrush" Value="#1F6FEB"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#EBF0FF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="+" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="프로그램 추가" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </GroupBox>

                <!-- xms 설정 -->
                <GroupBox>
                    <GroupBox.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#1F6FEB" CornerRadius="3" Padding="5,1" Margin="0,0,8,0">
                                <TextBlock Text="②" FontSize="11" FontWeight="Bold" Foreground="White"/>
                            </Border>
                            <TextBlock Text="xms 설정" FontWeight="SemiBold" Foreground="#24292F" VerticalAlignment="Center"/>
                            <Border Background="#FFF3E0" BorderBrush="#FFB74D" BorderThickness="1"
                                    CornerRadius="3" Padding="5,1" Margin="8,0,0,0">
                                <TextBlock Text="BAT 종료 시 실행" FontSize="10" Foreground="#E65100"/>
                            </Border>
                        </StackPanel>
                    </GroupBox.Header>
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="실행 위치" Style="{StaticResource FieldLabel}" Width="72"/>
                            <TextBlock Text="C:\Project\Release\xms\xms"
                                       Style="{StaticResource ExeFixedLabel}"/>
                        </DockPanel>

                        <DockPanel Margin="0,6,0,10">
                            <TextBlock Text="Map (.json)" Style="{StaticResource FieldLabel}" Width="72"/>
                            <Button Style="{StaticResource BrowseBtn}" DockPanel.Dock="Right"
                                    Click="BrowseXmsMap_Click"/>
                            <TextBox x:Name="XmsMapPath" IsReadOnly="True" Foreground="#57606A"
                                     Background="#FAFBFC"
                                     ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </DockPanel>

                        <TextBlock Text="명령어 1" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                        <Border Style="{StaticResource CmdBorder}">
                            <TextBlock Style="{StaticResource CmdText}" Text=".\xms.exe db drop -a"/>
                        </Border>

                        <TextBlock Text="명령어 2" Style="{StaticResource FieldLabel}" Margin="0,8,0,4"/>
                        <Border Style="{StaticResource CmdBorder}">
                            <TextBlock x:Name="XmsCmd2Preview" Style="{StaticResource CmdText}"
                                       Text='.\xms.exe db create "[Map .json 파일을 선택하세요]"'/>
                        </Border>
                    </StackPanel>
                </GroupBox>

                <!-- xflow 설정 -->
                <GroupBox>
                    <GroupBox.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#8250DF" CornerRadius="3" Padding="5,1" Margin="0,0,8,0">
                                <TextBlock Text="③" FontSize="11" FontWeight="Bold" Foreground="White"/>
                            </Border>
                            <TextBlock Text="xflow 설정" FontWeight="SemiBold" Foreground="#24292F" VerticalAlignment="Center"/>
                            <Border Background="#FFF3E0" BorderBrush="#FFB74D" BorderThickness="1"
                                    CornerRadius="3" Padding="5,1" Margin="8,0,0,0">
                                <TextBlock Text="xflowd 종료 시 실행" FontSize="10" Foreground="#E65100"/>
                            </Border>
                        </StackPanel>
                    </GroupBox.Header>
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="실행 위치" Style="{StaticResource FieldLabel}" Width="72"/>
                            <TextBlock Text="C:\Project\xflow\Src\xflow\bin\Debug\net10.0"
                                       Style="{StaticResource ExeFixedLabel}"/>
                        </DockPanel>

                        <DockPanel Margin="0,6,0,10">
                            <TextBlock Text="Map (.json)" Style="{StaticResource FieldLabel}" Width="72"/>
                            <Button Style="{StaticResource BrowseBtn}" DockPanel.Dock="Right"
                                    Click="BrowseXflowMap_Click"/>
                            <TextBox x:Name="XflowMapPath" IsReadOnly="True" Foreground="#57606A"
                                     Background="#FAFBFC"
                                     ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </DockPanel>

                        <TextBlock Text="명령어 1" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                        <Border Style="{StaticResource CmdBorder}">
                            <TextBlock Style="{StaticResource CmdText}" Text=".\xflow.exe db admin drop -a"/>
                        </Border>

                        <TextBlock Text="명령어 2" Style="{StaticResource FieldLabel}" Margin="0,8,0,4"/>
                        <Border Style="{StaticResource CmdBorder}">
                            <TextBlock x:Name="XflowCmd2Preview" Style="{StaticResource CmdText}"
                                       Text='.\xflow.exe db create -m "[Map .json 파일을 선택하세요]"'/>
                        </Border>
                    </StackPanel>
                </GroupBox>

                <!-- PostgreSQL -->
                <GroupBox>
                    <GroupBox.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#0A8070" CornerRadius="3" Padding="5,1" Margin="0,0,8,0">
                                <TextBlock Text="④" FontSize="11" FontWeight="Bold" Foreground="White"/>
                            </Border>
                            <TextBlock Text="PostgreSQL 설정" FontWeight="SemiBold" Foreground="#24292F" VerticalAlignment="Center"/>
                            <Border Background="#FFF3E0" BorderBrush="#FFB74D" BorderThickness="1"
                                    CornerRadius="3" Padding="5,1" Margin="8,0,0,0">
                                <TextBlock Text="xflowd 종료 시 실행" FontSize="10" Foreground="#E65100"/>
                            </Border>
                        </StackPanel>
                    </GroupBox.Header>
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Host" Style="{StaticResource FieldLabel}"/>
                            <TextBox   Grid.Column="1" x:Name="DbHost" Text="localhost" Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="2" Text="Port"  Style="{StaticResource FieldLabel}"/>
                            <TextBox   Grid.Column="3" x:Name="DbPort" Text="5432"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Database" Style="{StaticResource FieldLabel}"/>
                            <TextBox   Grid.Column="1" x:Name="DbName" Text="xflow" Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="2" Text="User"  Style="{StaticResource FieldLabel}"/>
                            <TextBox   Grid.Column="3" x:Name="DbUser" Text="postgres"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Password" Style="{StaticResource FieldLabel}"/>
                            <PasswordBox Grid.Column="1" x:Name="DbPassword"/>
                        </Grid>

                        <DockPanel>
                            <TextBlock Text="SQL 파일" Style="{StaticResource FieldLabel}" Width="60"/>
                            <Button Style="{StaticResource BrowseBtn}" DockPanel.Dock="Right"
                                    Click="BrowseSqlFile_Click"/>
                            <TextBox x:Name="SqlFilePath" IsReadOnly="True" Foreground="#57606A"
                                     Background="#FAFBFC"
                                     ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </DockPanel>
                    </StackPanel>
                </GroupBox>


            </StackPanel>
        </ScrollViewer>

        <!-- ── 로그 영역 ── -->
        <Border Grid.Row="4" BorderBrush="#30363D" BorderThickness="1"
                CornerRadius="6" Background="#0D1117" Margin="0"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 터미널 헤더 -->
                <Border Grid.Row="0" Background="#161B22" Padding="12,7"
                        BorderBrush="#30363D" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <TextBlock Text="실행 로그" DockPanel.Dock="Left" VerticalAlignment="Center"
                                   Foreground="#6E7681" FontFamily="Consolas" FontSize="12"/>
                        <Button DockPanel.Dock="Left" Content="지우기"
                                Width="50"
                                Click="LogClear_Click"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="10,0,0,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Padding" Value="6,3"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="Transparent"
                                                        BorderBrush="#30363D" BorderThickness="1"
                                                        CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <TextBlock x:Name="Tx" Text="{TemplateBinding Content}"
                                                               Foreground="#6E7681" FontSize="{TemplateBinding FontSize}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#58A6FF"/>
                                                        <Setter TargetName="Tx" Property="Foreground" Value="#79C0FF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </DockPanel>
                </Border>

                <!-- 로그 출력 -->
                <ScrollViewer Grid.Row="1" x:Name="LogScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Background="#0D1117">
                    <TextBox x:Name="LogBox"
                             Height="Auto"
                             MinHeight="100"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalAlignment="Stretch"
                             Background="#0D1117"
                             Foreground="#C9D1D9"
                             FontFamily="Consolas"
                             FontSize="12"
                             BorderThickness="0"
                             Padding="12,10"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
