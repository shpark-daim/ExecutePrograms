<Window x:Class="ExecutePrograms.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ExecutePrograms.Models"
        Title="ExecutePrograms" Icon="app.ico" Height="860" Width="820"
        MinHeight="640" MinWidth="740"
        Background="#F0F2F5">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#D0D7DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#24292F"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="BorderBrush" Value="#D0D7DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="BorderBrush" Value="#D0D7DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <!-- ── 전역 버튼 스타일 (시스템 크롬 완전 제거) ── -->
        <Style TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 찾기 버튼 -->
        <Style x:Key="BrowseBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Content" Value="찾기"/>
            <Setter Property="Background" Value="#F6F8FA"/>
            <Setter Property="Foreground" Value="#24292F"/>
            <Setter Property="BorderBrush" Value="#D0D7DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E6EBF0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 실행 버튼 (다크) -->
        <Style x:Key="DarkBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#333333"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#888888"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 저장 버튼 (앰버) -->
        <Style x:Key="SaveBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FFC107"/>
            <Setter Property="Foreground" Value="#1E1E1E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E6A800"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 삭제 버튼 (그레이/빨강) -->
        <Style x:Key="DeleteBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#F6F8FA"/>
            <Setter Property="Foreground" Value="#CF222E"/>
            <Setter Property="BorderBrush" Value="#D0D7DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFEBE9"/>
                    <Setter Property="BorderBrush" Value="#CF222E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 프로그램 추가 버튼 (고스트 앰버) -->
        <Style x:Key="GhostAmberBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E65100"/>
            <Setter Property="BorderBrush" Value="#FFC107"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF8E1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ✕ 제거 버튼 -->
        <Style x:Key="RemoveBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#CF222E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="#57606A"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <!-- 고정 명령어 표시 박스 -->
        <Style x:Key="CmdBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="#D0D7DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#F6F8FA"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CmdText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#656D76"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 프로그램 섹션 내부 구분 박스 -->
        <Style x:Key="PrgBlock" TargetType="Border">
            <Setter Property="BorderBrush" Value="#E8EBEF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="#FAFBFC"/>
        </Style>

        <Style x:Key="PrgLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#24292F"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- 단계 개별 실행 버튼 -->
        <Style x:Key="RunStepBtn" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="이 단계만 실행"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="11"
                                Background="Transparent" BorderThickness="0">
                            <TextBlock x:Name="Ic" Text="▶"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="9" Foreground="#C0C8D0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFF8E1"/>
                                <Setter TargetName="Ic" Property="Foreground" Value="#E65100"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Ic" Property="Foreground" Value="#E0E4EA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExeFixedLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#57606A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- ⚙ 설정 패널 토글 버튼 (ToggleButton) -->
        <Style x:Key="GearBtn" TargetType="ToggleButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width"  Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="Transparent" BorderThickness="0" CornerRadius="4">
                            <TextBlock x:Name="Ic" Text="☰" FontSize="15"
                                       Foreground="#8B949E"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F2F5"/>
                                <Setter TargetName="Ic" Property="Foreground" Value="#24292F"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E8EBEF"/>
                                <Setter TargetName="Ic" Property="Foreground" Value="#24292F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="12" x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 0: 프로필 바 -->
            <RowDefinition Height="*"/>     <!-- 1: 2열 콘텐츠 -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>  <!-- 0: 좌측 실행+로그 -->
            <ColumnDefinition Width="8"/>    <!-- 1: 열 간격 -->
            <ColumnDefinition Width="*"/>    <!-- 2: 우측 설정 -->
        </Grid.ColumnDefinitions>

        <!-- ── 프로필 바 (전체 너비) ── -->
        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                Background="White" BorderBrush="#D0D7DE" BorderThickness="1"
                CornerRadius="6" Margin="0,0,0,8" Padding="14,10">
            <DockPanel>
                <!-- 오른쪽: 설정 토글 / 고정 버튼 -->
                <ToggleButton x:Name="CollapseSettingsBtn"
                              DockPanel.Dock="Right"
                              IsChecked="True"
                              ToolTip="설정 접기"
                              Style="{StaticResource GearBtn}"
                              Click="CollapseSettings_Click"/>
                <Rectangle DockPanel.Dock="Right" Width="1" Fill="#D0D7DE" Margin="8,0,8,0"/>

                <!-- 왼쪽: 현재 프로필명 표시 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="프로필" FontSize="12" Foreground="#8B949E"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="CurrentProfileLabel"
                               FontSize="12" FontWeight="SemiBold" Foreground="#24292F"
                               VerticalAlignment="Center" Text="—"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── 우측: 설정 ── -->
        <ScrollViewer Grid.Row="1" Grid.Column="2"
                      x:Name="SettingsPanel"
                      VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- 프로필 관리 -->
                    <GroupBox>
                        <GroupBox.Header>
                            <TextBlock Text="프로필 관리" FontWeight="SemiBold"
                                       Foreground="#24292F" VerticalAlignment="Center"/>
                        </GroupBox.Header>
                        <DockPanel>
                            <Button Content="삭제" Width="52" Height="30"
                                    DockPanel.Dock="Right"
                                    FontSize="12" ToolTip="선택한 프로필 삭제"
                                    Style="{StaticResource DeleteBtn}"
                                    Click="DeleteProfile_Click"/>
                            <Button Content="저장" Width="52" Height="30"
                                    DockPanel.Dock="Right" Margin="0,0,4,0"
                                    FontSize="12" ToolTip="현재 설정을 이 이름으로 저장"
                                    Style="{StaticResource SaveBtn}"
                                    Click="SaveProfile_Click"/>
                            <ComboBox x:Name="ProfileComboBox"
                                      IsEditable="True" Height="30"
                                      VerticalContentAlignment="Center"
                                      Padding="6,0" FontSize="12"
                                      ToolTip="프로필 이름을 선택하거나 새 이름을 입력하세요"
                                      SelectionChanged="ProfileComboBox_SelectionChanged"/>
                        </DockPanel>
                    </GroupBox>

                    <!-- 실행 설정 -->
                    <GroupBox>
                        <GroupBox.Header>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#6E7681" CornerRadius="3" Padding="5,1" Margin="0,0,4,0">
                                    <TextBlock Text="①" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                </Border>
                                <Border Background="#6E7681" CornerRadius="3" Padding="5,1" Margin="0,0,8,0">
                                    <TextBlock Text="⑤" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                </Border>
                                <TextBlock Text="실행 설정" FontWeight="SemiBold" Foreground="#24292F" VerticalAlignment="Center"/>
                            </StackPanel>
                        </GroupBox.Header>
                        <StackPanel>

                            <!-- ── xms (서비스 / EXE 선택) ── -->
                            <Border x:Name="XmsServiceBlock" Style="{StaticResource PrgBlock}">
                                <StackPanel>
                                    <!-- 헤더: 이름 (왼쪽) / 모드 선택 + 창 표시 + 제거 (오른쪽 정렬) -->
                                    <DockPanel Margin="0,0,0,8">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <CheckBox x:Name="XmsShowWindowCheck" Content="창 표시"
                                                      IsChecked="True" VerticalAlignment="Center" Margin="0,0,14,0"
                                                      FontSize="11" Foreground="#57606A"
                                                      ToolTip="EXE 모드에서 해제하면 창 없이 실행하고 오류 출력을 로그창에 표시합니다"/>
                                            <RadioButton x:Name="XmsExeRadio" Content="EXE"
                                                         GroupName="XmsMode" IsChecked="False"
                                                         FontSize="11" Foreground="#57606A"
                                                         Margin="0,0,10,0" VerticalAlignment="Center"
                                                         Checked="XmsMode_Changed"/>
                                            <RadioButton x:Name="XmsSvcRadio" Content="서비스"
                                                         GroupName="XmsMode" IsChecked="True"
                                                         FontSize="11" Foreground="#57606A"
                                                         VerticalAlignment="Center"
                                                         Checked="XmsMode_Changed"/>
                                            <Rectangle Width="1" Fill="#D0D7DE" Margin="8,0"/>
                                            <Button Content="✕" Width="20" Height="20"
                                                    Style="{StaticResource RemoveBtn}" ToolTip="xms 제거"
                                                    Click="RemoveXms_Click"/>
                                        </StackPanel>
                                        <TextBlock Text="● xms" Style="{StaticResource PrgLabel}"
                                                   Margin="0,0,0,0" VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <!-- 서비스 모드 (xms.exe) -->
                                    <StackPanel x:Name="XmsSvcPanel" Visibility="Visible">
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="실행 위치" Style="{StaticResource FieldLabel}" Width="72"/>
                                            <Button Style="{StaticResource BrowseBtn}" DockPanel.Dock="Right"
                                                    Click="BrowseBatDir_Click"/>
                                            <TextBox x:Name="BatDir"
                                                     ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,4,0,4">
                                            <TextBlock Text="시작" Style="{StaticResource FieldLabel}" Width="36" DockPanel.Dock="Left"/>
                                            <Border Style="{StaticResource CmdBorder}">
                                                <TextBlock Style="{StaticResource CmdText}" Text=".\xms.exe service start"/>
                                            </Border>
                                        </DockPanel>
                                        <DockPanel>
                                            <TextBlock Text="종료" Style="{StaticResource FieldLabel}" Width="36" DockPanel.Dock="Left"/>
                                            <Border Style="{StaticResource CmdBorder}">
                                                <TextBlock Style="{StaticResource CmdText}" Text=".\xms.exe service stop"/>
                                            </Border>
                                        </DockPanel>
                                    </StackPanel>

                                    <!-- EXE 모드 (xmsd.exe) -->
                                    <StackPanel x:Name="XmsExePanel" Visibility="Collapsed">
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="실행 위치" Style="{StaticResource FieldLabel}" Width="72"/>
                                            <Button Style="{StaticResource BrowseBtn}" DockPanel.Dock="Right"
                                                    Click="BrowseXmsExeDir_Click"/>
                                            <TextBox x:Name="XmsExeDir"
                                                     ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,4,0,4">
                                            <TextBlock Text="시작" Style="{StaticResource FieldLabel}" Width="36" DockPanel.Dock="Left"/>
                                            <Border Style="{StaticResource CmdBorder}">
                                                <TextBlock Style="{StaticResource CmdText}" Text=".\xmsd.exe"/>
                                            </Border>
                                        </DockPanel>
                                        <DockPanel>
                                            <TextBlock Text="종료" Style="{StaticResource FieldLabel}" Width="36" DockPanel.Dock="Left"/>
                                            <Border Style="{StaticResource CmdBorder}">
                                                <TextBlock Style="{StaticResource CmdText}" Text="xmsd.exe 프로세스 종료"/>
                                            </Border>
                                        </DockPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- ── xflow (서비스 / EXE 선택) ── -->
                            <Border x:Name="XflowServiceBlock" Style="{StaticResource PrgBlock}">
                                <StackPanel>
                                    <!-- 헤더: 이름 (왼쪽) / 모드 선택 + 창 표시 + 제거 (오른쪽 정렬) -->
                                    <DockPanel Margin="0,0,0,8">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <CheckBox x:Name="XflowShowWindowCheck" Content="창 표시"
                                                      IsChecked="True" VerticalAlignment="Center" Margin="0,0,14,0"
                                                      FontSize="11" Foreground="#57606A"
                                                      ToolTip="EXE 모드에서 해제하면 창 없이 실행하고 오류 출력을 로그창에 표시합니다"/>
                                            <RadioButton x:Name="XflowExeRadio" Content="EXE"
                                                         GroupName="XflowMode" IsChecked="True"
                                                         FontSize="11" Foreground="#57606A"
                                                         Margin="0,0,10,0" VerticalAlignment="Center"
                                                         Checked="XflowMode_Changed"/>
                                            <RadioButton x:Name="XflowSvcRadio" Content="서비스"
                                                         GroupName="XflowMode" IsChecked="False"
                                                         FontSize="11" Foreground="#57606A"
                                                         VerticalAlignment="Center"
                                                         Checked="XflowMode_Changed"/>
                                            <Rectangle Width="1" Fill="#D0D7DE" Margin="8,0"/>
                                            <Button Content="✕" Width="20" Height="20"
                                                    Style="{StaticResource RemoveBtn}" ToolTip="xflow 제거"
                                                    Click="RemoveXflow_Click"/>
                                        </StackPanel>
                                        <TextBlock Text="● xflow" Style="{StaticResource PrgLabel}"
                                                   Margin="0,0,0,0" VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <!-- 서비스 모드 (xflow.exe) -->
                                    <StackPanel x:Name="XflowSvcPanel" Visibility="Collapsed">
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="실행 위치" Style="{StaticResource FieldLabel}" Width="72"/>
                                            <Button Style="{StaticResource BrowseBtn}" DockPanel.Dock="Right"
                                                    Click="BrowseXflowSvcDir_Click"/>
                                            <TextBox x:Name="XflowSvcDir"
                                                     ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,4,0,4">
                                            <TextBlock Text="시작" Style="{StaticResource FieldLabel}" Width="36" DockPanel.Dock="Left"/>
                                            <Border Style="{StaticResource CmdBorder}">
                                                <TextBlock Style="{StaticResource CmdText}" Text=".\xflow.exe service start"/>
                                            </Border>
                                        </DockPanel>
                                        <DockPanel>
                                            <TextBlock Text="종료" Style="{StaticResource FieldLabel}" Width="36" DockPanel.Dock="Left"/>
                                            <Border Style="{StaticResource CmdBorder}">
                                                <TextBlock Style="{StaticResource CmdText}" Text=".\xflow.exe service stop"/>
                                            </Border>
                                        </DockPanel>
                                    </StackPanel>

                                    <!-- EXE 모드 (xflowd.exe) -->
                                    <StackPanel x:Name="XflowExePanel" Visibility="Visible">
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="실행 위치" Style="{StaticResource FieldLabel}" Width="72"/>
                                            <Button Style="{StaticResource BrowseBtn}" DockPanel.Dock="Right"
                                                    Click="BrowseExeDir_Click"/>
                                            <TextBox x:Name="ExeDir"
                                                     ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,4,0,4">
                                            <TextBlock Text="시작" Style="{StaticResource FieldLabel}" Width="36" DockPanel.Dock="Left"/>
                                            <Border Style="{StaticResource CmdBorder}">
                                                <TextBlock Style="{StaticResource CmdText}" Text=".\xflowd.exe"/>
                                            </Border>
                                        </DockPanel>
                                        <DockPanel>
                                            <TextBlock Text="종료" Style="{StaticResource FieldLabel}" Width="36" DockPanel.Dock="Left"/>
                                            <Border Style="{StaticResource CmdBorder}">
                                                <TextBlock Style="{StaticResource CmdText}" Text="xflowd.exe 프로세스 종료"/>
                                            </Border>
                                        </DockPanel>
                                    </StackPanel>

                                </StackPanel>
                            </Border>

                            <!-- ── FEX ── -->
                            <Border x:Name="FexServiceBlock" Style="{StaticResource PrgBlock}" Margin="0,0,0,8">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <Button DockPanel.Dock="Right" Content="✕" Width="20" Height="20"
                                                Style="{StaticResource RemoveBtn}" ToolTip="FEX 제거"
                                                Click="RemoveFex_Click"/>
                                        <TextBlock Text="● FEX  (GUI)"
                                                   FontSize="12" FontWeight="SemiBold" Foreground="#24292F"/>
                                    </DockPanel>

                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="워크스페이스" Style="{StaticResource FieldLabel}" Width="72"/>
                                        <TextBox x:Name="FexWorkspace"
                                                 ToolTip="비워두면 Default 워크스페이스로 실행"/>
                                    </DockPanel>

                                    <DockPanel Margin="0,4,0,4">
                                        <TextBlock Text="시작" Style="{StaticResource FieldLabel}" Width="36" DockPanel.Dock="Left"/>
                                        <Border Style="{StaticResource CmdBorder}">
                                            <TextBlock Style="{StaticResource CmdText}" Text="Fex Hub.exe"/>
                                        </Border>
                                    </DockPanel>

                                    <DockPanel>
                                        <TextBlock Text="종료" Style="{StaticResource FieldLabel}" Width="36" DockPanel.Dock="Left"/>
                                        <Border Style="{StaticResource CmdBorder}">
                                            <TextBlock Style="{StaticResource CmdText}" Text="Fex.exe 프로세스 종료"/>
                                        </Border>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <!-- ── 추가 프로그램 목록 ── -->
                            <ItemsControl x:Name="ExtraProgramsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:ExtraProgram}">
                                        <Border Background="#FAFBFC" BorderBrush="#D0D7DE" BorderThickness="1"
                                                CornerRadius="4" Padding="12,10" Margin="0,0,0,8">
                                            <StackPanel>

                                                <!-- 이름 + 창표시 + 제거 -->
                                                <DockPanel Margin="0,0,0,8">
                                                    <Button DockPanel.Dock="Right"
                                                            Content="✕" Width="28" Height="28"
                                                            ToolTip="제거"
                                                            Style="{StaticResource RemoveBtn}"
                                                            Click="RemoveExtraProgram_Click"/>
                                                    <CheckBox DockPanel.Dock="Right" Content="창 표시"
                                                              IsChecked="{Binding ShowWindow}"
                                                              VerticalAlignment="Center" Margin="0,0,8,0"
                                                              FontSize="12" Foreground="#57606A"/>
                                                    <TextBlock Text="이름" Width="72" VerticalAlignment="Center"
                                                               FontSize="12" Foreground="#57606A" FontWeight="SemiBold"/>
                                                    <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                                             FontSize="12"/>
                                                </DockPanel>

                                                <!-- 실행 파일 경로 -->
                                                <DockPanel>
                                                    <TextBlock Text="실행 파일" Width="72" VerticalAlignment="Center"
                                                               FontSize="12" Foreground="#57606A" FontWeight="SemiBold"/>
                                                    <Button DockPanel.Dock="Right"
                                                            Content="찾기" Width="60" Height="30" Margin="6,0,0,0"
                                                            Cursor="Hand" Click="BrowseExtraExe_Click"
                                                            Style="{StaticResource BrowseBtn}"/>
                                                    <TextBox Text="{Binding ExePath, UpdateSourceTrigger=PropertyChanged}"
                                                             FontSize="12"
                                                             ToolTip="{Binding ExePath}"/>
                                                </DockPanel>

                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 복구 버튼 + 프로그램 추가 버튼 (한 줄) -->
                            <WrapPanel HorizontalAlignment="Right" Margin="0,0,0,4">
                                <Button x:Name="RestoreXmsBtn" Content="+ xms"
                                        Visibility="Collapsed" Click="RestoreXms_Click"
                                        Style="{StaticResource GhostAmberBtn}"
                                        Height="30" Padding="10,0" FontSize="12" Margin="0,0,6,0"/>
                                <Button x:Name="RestoreXflowBtn" Content="+ xflow"
                                        Visibility="Collapsed" Click="RestoreXflow_Click"
                                        Style="{StaticResource GhostAmberBtn}"
                                        Height="30" Padding="10,0" FontSize="12" Margin="0,0,6,0"/>
                                <Button x:Name="RestoreFexBtn" Content="+ FEX"
                                        Visibility="Collapsed" Click="RestoreFex_Click"
                                        Style="{StaticResource GhostAmberBtn}"
                                        Height="30" Padding="10,0" FontSize="12" Margin="0,0,6,0"/>
                                <Button Click="AddExtraProgram_Click"
                                        Height="30" Padding="12,0" FontSize="12"
                                        Style="{StaticResource GhostAmberBtn}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="+" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="프로그램 추가" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>

                        </StackPanel>
                    </GroupBox>

                    <!-- xms 설정 -->
                    <GroupBox x:Name="XmsDbGroupBox">
                        <GroupBox.Header>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#6E7681" CornerRadius="3" Padding="5,1" Margin="0,0,8,0">
                                    <TextBlock Text="②" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                </Border>
                                <TextBlock FontWeight="SemiBold" Foreground="#24292F" VerticalAlignment="Center">
                                    <Run Text="xms 설정"/><Run Text="  (map 설정)" FontSize="11" Foreground="#8B949E"/>
                                </TextBlock>
                            </StackPanel>
                        </GroupBox.Header>
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="실행 위치" Style="{StaticResource FieldLabel}" Width="72"/>
                                <Button Style="{StaticResource BrowseBtn}" DockPanel.Dock="Right"
                                        Click="BrowseXmsDbDir_Click"/>
                                <TextBox x:Name="XmsDbDir"
                                         ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            </DockPanel>

                            <DockPanel Margin="0,6,0,10">
                                <TextBlock Text="Map (.json)" Style="{StaticResource FieldLabel}" Width="72"/>
                                <Button Style="{StaticResource BrowseBtn}" DockPanel.Dock="Right"
                                        Click="BrowseXmsMap_Click"/>
                                <TextBox x:Name="XmsMapPath" IsReadOnly="True" Foreground="#57606A"
                                         Background="#FAFBFC"
                                         ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            </DockPanel>

                            <TextBlock Text="명령어 1" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                            <Border Style="{StaticResource CmdBorder}">
                                <TextBlock Style="{StaticResource CmdText}" Text=".\xms.exe db drop -a"/>
                            </Border>

                            <TextBlock Text="명령어 2" Style="{StaticResource FieldLabel}" Margin="0,8,0,4"/>
                            <Border Style="{StaticResource CmdBorder}">
                                <TextBlock x:Name="XmsCmd2Preview" Style="{StaticResource CmdText}"
                                           Text='.\xms.exe db create "[Map .json 파일을 선택하세요]"'/>
                            </Border>
                        </StackPanel>
                    </GroupBox>

                    <!-- xflow 설정 -->
                    <GroupBox x:Name="XflowDbGroupBox">
                        <GroupBox.Header>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#6E7681" CornerRadius="3" Padding="5,1" Margin="0,0,8,0">
                                    <TextBlock Text="③" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                </Border>
                                <TextBlock FontWeight="SemiBold" Foreground="#24292F" VerticalAlignment="Center">
                                    <Run Text="xflow 설정"/><Run Text="  (map 설정)" FontSize="11" Foreground="#8B949E"/>
                                </TextBlock>
                            </StackPanel>
                        </GroupBox.Header>
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="실행 위치" Style="{StaticResource FieldLabel}" Width="72"/>
                                <Button Style="{StaticResource BrowseBtn}" DockPanel.Dock="Right"
                                        Click="BrowseXflowDbDir_Click"/>
                                <TextBox x:Name="XflowDbDir"
                                         ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            </DockPanel>

                            <DockPanel Margin="0,6,0,10">
                                <TextBlock Text="Map (.json)" Style="{StaticResource FieldLabel}" Width="72"/>
                                <Button Style="{StaticResource BrowseBtn}" DockPanel.Dock="Right"
                                        Click="BrowseXflowMap_Click"/>
                                <TextBox x:Name="XflowMapPath" IsReadOnly="True" Foreground="#57606A"
                                         Background="#FAFBFC"
                                         ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            </DockPanel>

                            <TextBlock Text="명령어 1" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                            <Border Style="{StaticResource CmdBorder}">
                                <TextBlock Style="{StaticResource CmdText}" Text=".\xflow.exe db admin drop -a"/>
                            </Border>

                            <TextBlock Text="명령어 2" Style="{StaticResource FieldLabel}" Margin="0,8,0,4"/>
                            <Border Style="{StaticResource CmdBorder}">
                                <TextBlock x:Name="XflowCmd2Preview" Style="{StaticResource CmdText}"
                                           Text='.\xflow.exe db create -m "[Map .json 파일을 선택하세요]"'/>
                            </Border>
                        </StackPanel>
                    </GroupBox>

                    <!-- PostgreSQL -->
                    <GroupBox x:Name="SqlGroupBox">
                        <GroupBox.Header>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#6E7681" CornerRadius="3" Padding="5,1" Margin="0,0,8,0">
                                    <TextBlock Text="④" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                </Border>
                                <TextBlock Text="PostgreSQL 설정" FontWeight="SemiBold" Foreground="#24292F" VerticalAlignment="Center"/>
                            </StackPanel>
                        </GroupBox.Header>
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Host" Style="{StaticResource FieldLabel}"/>
                                <TextBox   Grid.Column="1" x:Name="DbHost" Text="localhost" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="2" Text="Port"  Style="{StaticResource FieldLabel}"/>
                                <TextBox   Grid.Column="3" x:Name="DbPort" Text="5432"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Database" Style="{StaticResource FieldLabel}"/>
                                <TextBox   Grid.Column="1" x:Name="DbName" Text="xflow" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="2" Text="User"  Style="{StaticResource FieldLabel}"/>
                                <TextBox   Grid.Column="3" x:Name="DbUser" Text="postgres"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Password" Style="{StaticResource FieldLabel}"/>
                                <PasswordBox Grid.Column="1" x:Name="DbPassword"/>
                            </Grid>

                            <DockPanel>
                                <TextBlock Text="SQL 파일" Style="{StaticResource FieldLabel}" Width="60"/>
                                <Button Style="{StaticResource BrowseBtn}" DockPanel.Dock="Right"
                                        Click="BrowseSqlFile_Click"/>
                                <TextBox x:Name="SqlFilePath" IsReadOnly="True" Foreground="#57606A"
                                         Background="#FAFBFC"
                                         ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            </DockPanel>
                        </StackPanel>
                    </GroupBox>

                </StackPanel>
        </ScrollViewer>

        <!-- ── 좌측 패널: 실행 버튼 + Step + 서비스 상태 + 로그 ── -->
        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- 실행 버튼 -->
                <RowDefinition Height="Auto"/>  <!-- Step indicator -->
                <RowDefinition Height="Auto"/>  <!-- 서비스 상태 -->
                <RowDefinition Height="*"/>     <!-- 로그 -->
            </Grid.RowDefinitions>

            <!-- ── 실행 버튼 ── -->
            <Button x:Name="ExecuteBtn" Grid.Row="0"
                    Content="▶  실행"
                    Height="44" Margin="0,0,0,8"
                    FontSize="15" FontWeight="Bold"
                    Style="{StaticResource DarkBtn}"
                    Click="ExecuteBtn_Click"/>

            <!-- ── 세로 Step indicator ── -->
            <Border Grid.Row="1" Background="White" BorderBrush="#D0D7DE" BorderThickness="1"
                    CornerRadius="6" Margin="0,0,0,8" Padding="12,10">
                <StackPanel>

                    <!-- 전체 선택 헤더 -->
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="실행할 단계" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#8B949E" VerticalAlignment="Center"/>
                        <CheckBox x:Name="SelectAllCheck"
                                  DockPanel.Dock="Right"
                                  IsThreeState="False"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Click="SelectAllCheck_Click">
                            <CheckBox.Content>
                                <TextBlock Text="전체 선택" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#E65100"/>
                            </CheckBox.Content>
                        </CheckBox>
                    </DockPanel>
                    <Separator Background="#E8EBEF" Margin="-12,0,-12,8"/>

                    <!-- ① 종료 (Stop 체크박스 포함) -->
                    <Border x:Name="Step1Border" Background="#F6F8FA" BorderBrush="#D0D7DE"
                            BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="① 종료"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="#24292F" Margin="0,0,0,6"/>
                                <WrapPanel>
                                    <CheckBox x:Name="BatStopCheck" Content="xms" IsChecked="True"
                                              FontSize="11" Foreground="#57606A" Margin="0,0,10,2"
                                              Checked="IndividualCheck_Changed" Unchecked="IndividualCheck_Changed"/>
                                    <CheckBox x:Name="ExeStopCheck" Content="xflow" IsChecked="True"
                                              FontSize="11" Foreground="#57606A" Margin="0,0,10,2"
                                              Checked="IndividualCheck_Changed" Unchecked="IndividualCheck_Changed"/>
                                    <CheckBox x:Name="FexStopCheck" Content="FEX" IsChecked="True"
                                              FontSize="11" Foreground="#57606A" Margin="0,0,10,2"
                                              Checked="IndividualCheck_Changed" Unchecked="IndividualCheck_Changed"/>
                                    <ItemsControl x:Name="ExtraStopChecks">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:ExtraProgram}">
                                                <CheckBox IsChecked="{Binding StopEnabled}"
                                                          Content="{Binding DisplayName, Mode=OneWay}"
                                                          FontSize="11" Foreground="#57606A"
                                                          Margin="0,0,10,2"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </WrapPanel>
                            </StackPanel>
                            <Button x:Name="RunStep1Btn" Grid.Column="1"
                                    Style="{StaticResource RunStepBtn}"
                                    VerticalAlignment="Center" Margin="6,0,2,0"
                                    Click="RunStep1_Click"/>
                            <TextBlock x:Name="Step1Text" Grid.Column="2"
                                       Text="○" FontSize="14" FontWeight="Bold"
                                       Foreground="#8B949E" VerticalAlignment="Center"
                                       Margin="4,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- ② xms DB -->
                    <Border x:Name="Step2Border" Background="#F6F8FA" BorderBrush="#D0D7DE"
                            BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock FontSize="12" FontWeight="SemiBold"
                                           Foreground="#24292F" Margin="0,0,0,6">
                                    <Run Text="② xms DB"/><Run Text="  (map 설정)" FontSize="11" FontWeight="Normal" Foreground="#8B949E"/>
                                </TextBlock>
                                <CheckBox x:Name="XmsDbCheck" Content="drop / create 실행" IsChecked="True"
                                          FontSize="11" Foreground="#57606A"
                                          Checked="IndividualCheck_Changed" Unchecked="IndividualCheck_Changed"/>
                            </StackPanel>
                            <Button x:Name="RunStep2Btn" Grid.Column="1"
                                    Style="{StaticResource RunStepBtn}"
                                    VerticalAlignment="Center" Margin="6,0,2,0"
                                    Click="RunStep2_Click"/>
                            <TextBlock x:Name="Step2Text" Grid.Column="2"
                                       Text="○" FontSize="14" FontWeight="Bold"
                                       Foreground="#8B949E" VerticalAlignment="Center"
                                       Margin="4,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- ③ xflow DB -->
                    <Border x:Name="Step3Border" Background="#F6F8FA" BorderBrush="#D0D7DE"
                            BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock FontSize="12" FontWeight="SemiBold"
                                           Foreground="#24292F" Margin="0,0,0,6">
                                    <Run Text="③ xflow DB"/><Run Text="  (map 설정)" FontSize="11" FontWeight="Normal" Foreground="#8B949E"/>
                                </TextBlock>
                                <CheckBox x:Name="XflowDbCheck" Content="drop / create 실행" IsChecked="True"
                                          FontSize="11" Foreground="#57606A"
                                          Checked="IndividualCheck_Changed" Unchecked="IndividualCheck_Changed"/>
                            </StackPanel>
                            <Button x:Name="RunStep3Btn" Grid.Column="1"
                                    Style="{StaticResource RunStepBtn}"
                                    VerticalAlignment="Center" Margin="6,0,2,0"
                                    Click="RunStep3_Click"/>
                            <TextBlock x:Name="Step3Text" Grid.Column="2"
                                       Text="○" FontSize="14" FontWeight="Bold"
                                       Foreground="#8B949E" VerticalAlignment="Center"
                                       Margin="4,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- ④ SQL -->
                    <Border x:Name="Step4Border" Background="#F6F8FA" BorderBrush="#D0D7DE"
                            BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="④ SQL"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="#24292F" Margin="0,0,0,6"/>
                                <CheckBox x:Name="SqlCheck" Content="SQL 파일 실행" IsChecked="True"
                                          FontSize="11" Foreground="#57606A"
                                          Checked="IndividualCheck_Changed" Unchecked="IndividualCheck_Changed"/>
                            </StackPanel>
                            <Button x:Name="RunStep4Btn" Grid.Column="1"
                                    Style="{StaticResource RunStepBtn}"
                                    VerticalAlignment="Center" Margin="6,0,2,0"
                                    Click="RunStep4_Click"/>
                            <TextBlock x:Name="Step4Text" Grid.Column="2"
                                       Text="○" FontSize="14" FontWeight="Bold"
                                       Foreground="#8B949E" VerticalAlignment="Center"
                                       Margin="4,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- ⑤ 시작 (Start 체크박스 포함) -->
                    <Border x:Name="Step5Border" Background="#F6F8FA" BorderBrush="#D0D7DE"
                            BorderThickness="1" CornerRadius="4" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="⑤ 시작"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="#24292F" Margin="0,0,0,6"/>
                                <WrapPanel>
                                    <CheckBox x:Name="BatStartCheck" Content="xms" IsChecked="True"
                                              FontSize="11" Foreground="#57606A" Margin="0,0,10,2"
                                              Checked="IndividualCheck_Changed" Unchecked="IndividualCheck_Changed"/>
                                    <CheckBox x:Name="ExeStartCheck" Content="xflow" IsChecked="True"
                                              FontSize="11" Foreground="#57606A" Margin="0,0,10,2"
                                              Checked="IndividualCheck_Changed" Unchecked="IndividualCheck_Changed"/>
                                    <CheckBox x:Name="FexStartCheck" Content="FEX" IsChecked="True"
                                              FontSize="11" Foreground="#57606A" Margin="0,0,10,2"
                                              Checked="IndividualCheck_Changed" Unchecked="IndividualCheck_Changed"/>
                                    <ItemsControl x:Name="ExtraStartChecks">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:ExtraProgram}">
                                                <CheckBox IsChecked="{Binding StartEnabled}"
                                                          Content="{Binding DisplayName, Mode=OneWay}"
                                                          FontSize="11" Foreground="#57606A"
                                                          Margin="0,0,10,2"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </WrapPanel>
                            </StackPanel>
                            <Button x:Name="RunStep5Btn" Grid.Column="1"
                                    Style="{StaticResource RunStepBtn}"
                                    VerticalAlignment="Center" Margin="6,0,2,0"
                                    Click="RunStep5_Click"/>
                            <TextBlock x:Name="Step5Text" Grid.Column="2"
                                       Text="○" FontSize="14" FontWeight="Bold"
                                       Foreground="#8B949E" VerticalAlignment="Center"
                                       Margin="4,0,0,0"/>
                        </Grid>
                    </Border>

                </StackPanel>
            </Border>

            <!-- ── 서비스 상태 모니터 ── -->
            <Border Grid.Row="2" Background="White" BorderBrush="#D0D7DE" BorderThickness="1"
                    CornerRadius="6" Margin="0,0,0,8" Padding="10,8">
                <StackPanel>
                    <!-- 헤더 -->
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Right" Text="5초 갱신" FontSize="10"
                                   Foreground="#C0C8D0" VerticalAlignment="Center"/>
                        <TextBlock Text="실행 상태" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#8B949E"/>
                    </DockPanel>

                    <!-- xms 행 -->
                    <Grid x:Name="XmsStatusRow" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="xms" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#57606A" VerticalAlignment="Top" Margin="0,1,0,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="XmsPlaceholder" Text="—" FontSize="11"
                                       Foreground="#8B949E"/>
                            <WrapPanel x:Name="XmsComponentsPanel" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>

                    <!-- xflow 행 -->
                    <Grid x:Name="XflowStatusRow" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="xflow" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#57606A" VerticalAlignment="Top" Margin="0,1,0,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="XflowPlaceholder" Text="—" FontSize="11"
                                       Foreground="#8B949E"/>
                            <WrapPanel x:Name="XflowComponentsPanel" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>

                    <!-- FEX 행 -->
                    <Grid x:Name="FexStatusRow" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="FEX" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#57606A" VerticalAlignment="Top" Margin="0,1,0,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="FexPlaceholder" Text="—" FontSize="11"
                                       Foreground="#8B949E"/>
                            <WrapPanel x:Name="FexComponentsPanel" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>

                    <!-- 추가 프로그램 행 (등록된 항목이 있을 때만 표시) -->
                    <Grid x:Name="ExtraStatusRow" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="etc" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#57606A" VerticalAlignment="Top" Margin="0,1,0,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="ExtraPlaceholder" Text="—" FontSize="11"
                                       Foreground="#8B949E"/>
                            <WrapPanel x:Name="ExtraComponentsPanel" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>

                </StackPanel>
            </Border>

            <!-- ── 로그 영역 ── -->
            <Border Grid.Row="3" BorderBrush="#30363D" BorderThickness="1"
                    CornerRadius="6" Background="#0D1117"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 터미널 헤더 -->
                    <Border Grid.Row="0" Background="#161B22" Padding="12,7"
                            BorderBrush="#30363D" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <TextBlock Text="실행 로그" DockPanel.Dock="Left" VerticalAlignment="Center"
                                       Foreground="#6E7681" FontFamily="Consolas" FontSize="12"/>
                            <Button DockPanel.Dock="Left" Content="저장"
                                    Width="50"
                                    Click="LogSave_Click"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="10,0,0,0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="Padding" Value="6,3"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Background="Transparent"
                                                            BorderBrush="#30363D" BorderThickness="1"
                                                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <TextBlock x:Name="Tx" Text="{TemplateBinding Content}"
                                                                   Foreground="#6E7681" FontSize="{TemplateBinding FontSize}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#58A6FF"/>
                                                            <Setter TargetName="Tx" Property="Foreground" Value="#79C0FF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        <Button DockPanel.Dock="Left" Content="지우기"
                                    Width="50"
                                    Click="LogClear_Click"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="10,0,0,0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="Padding" Value="6,3"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Background="Transparent"
                                                            BorderBrush="#30363D" BorderThickness="1"
                                                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <TextBlock x:Name="Tx" Text="{TemplateBinding Content}"
                                                                   Foreground="#6E7681" FontSize="{TemplateBinding FontSize}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#58A6FF"/>
                                                            <Setter TargetName="Tx" Property="Foreground" Value="#79C0FF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DockPanel>
                    </Border>

                    <!-- 로그 출력 -->
                    <ScrollViewer Grid.Row="1" x:Name="LogScroll"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Background="#0D1117">
                        <TextBox x:Name="LogBox"
                                 Height="Auto"
                                 MinHeight="100"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalAlignment="Stretch"
                                 Background="#0D1117"
                                 Foreground="#C9D1D9"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 BorderThickness="0"
                                 Padding="12,10"/>
                    </ScrollViewer>
                </Grid>
            </Border>

        </Grid>

    </Grid>
</Window>
