<Window x:Class="ExecutePrograms.SqlLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SQL 실행 로그" Height="480" Width="660"
        MinHeight="300" MinWidth="400"
        Background="#0D1117">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#161B22" Padding="12,7"
                BorderBrush="#30363D" BorderThickness="0,0,0,1">
            <DockPanel>
                <TextBlock Text="SQL 실행 로그" DockPanel.Dock="Left"
                           VerticalAlignment="Center"
                           Foreground="#6E7681" FontFamily="Consolas" FontSize="12"/>
                <Button DockPanel.Dock="Left" Content="지우기" Width="50"
                        Click="LogClear_Click"
                        VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="Padding" Value="6,3"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="Transparent"
                                                BorderBrush="#30363D" BorderThickness="1"
                                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <TextBlock x:Name="Tx" Text="{TemplateBinding Content}"
                                                       Foreground="#6E7681" FontSize="{TemplateBinding FontSize}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#58A6FF"/>
                                                <Setter TargetName="Tx" Property="Foreground" Value="#79C0FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" x:Name="LogScroll"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="#0D1117">
            <TextBox x:Name="LogBox"
                     IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                     Background="#0D1117" Foreground="#C9D1D9"
                     FontFamily="Consolas" FontSize="12"
                     BorderThickness="0" Padding="12,10"/>
        </ScrollViewer>
    </Grid>
</Window>
